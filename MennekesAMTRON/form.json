{
    "elements": [
        {
            "type": "Label",
            "caption": "Verbindung zum Ladecontroller (Modbus TCP, meist Port 502, Unit-ID 1). Gateway und Client Socket darüber stellt die Instanz selbst ein; dort nichts von Hand ändern."
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "ValidationTextBox",
                    "name": "Host",
                    "caption": "Adresse (IP oder Hostname)"
                },
                {
                    "type": "NumberSpinner",
                    "name": "Port",
                    "caption": "Port",
                    "minimum": 1,
                    "maximum": 65535
                },
                {
                    "type": "NumberSpinner",
                    "name": "DeviceID",
                    "caption": "Unit-ID",
                    "minimum": 1,
                    "maximum": 247
                }
            ]
        },
        {
            "type": "CheckBox",
            "name": "Open",
            "caption": "Verbindung aktiv"
        },
        {
            "type": "Label",
            "name": "LetzterAbruf",
            "caption": "Letzter erfolgreicher Abruf: noch keiner"
        },
        {
            "type": "Label",
            "caption": "Die Wallbox nimmt nur EINE Modbus-Verbindung an. Jede neue wirft die vorige hinaus. Neben dieser Instanz darf kein anderer Leser laufen."
        },
        {
            "type": "NumberSpinner",
            "name": "Interval",
            "caption": "Abfrage alle",
            "suffix": "Sekunden",
            "minimum": 5
        },
        {
            "type": "CheckBox",
            "name": "AllowWrite",
            "caption": "Schreibzugriff erlauben (HEMS-Stromgrenze)"
        },
        {
            "type": "Label",
            "caption": "Ohne Haken liest die Instanz nur. Der Haken schaltet die Bedienung der HEMS-Stromgrenze frei und die Funktion AMTRON_SetCurrentLimit."
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Verbindung testen",
            "onClick": "AMTRON_TestConnection($id);"
        },
        {
            "type": "Label",
            "caption": "Liest einmal alle Werte und zeigt das Ergebnis. Geänderte Felder vorher mit „Änderungen übernehmen“ speichern."
        }
    ],
    "status": [
        {
            "code": 201,
            "icon": "error",
            "caption": "Keine Adresse eingetragen"
        }
    ]
}
